# NutriVision AI · local secrets template
# --------------------------------------
# Copy this file to `.env` (gitignored) and replace the values:
#
#     cp .env.example .env
#     $EDITOR .env
#     flutter run
#
# Anything left blank or omitted will fall back to the corresponding
# --dart-define flag (used in CI / production builds). When both are
# absent, the app falls back to deterministic mock services so it still
# runs in the iOS Simulator with zero configuration.

# Google Gemini API key for food-image recognition.
#
# Sign up at https://aistudio.google.com/apikey and paste a token that
# begins with `AIza`. An empty value keeps the app in mock mode.
AQ.Ab8RN6L71asmUsXiTKDkRcU1fizEcjlES5Snn6rULZUzkhpWbg

# Override the default 'gemini-1.5-flash' model with a more accurate
# (and slower / pricier) variant: gemini-1.5-pro, or experimental
# gemini-2.0-flash-exp. Any vision-capable model works.
GEMINI_VISION_MODEL=gemini-3.1-flash-lite

# Force the local mock pipeline even when GEMINI_API_KEY is set.
# Useful for CI snapshot tests or offline debugging.
USE_MOCK_AI=false
